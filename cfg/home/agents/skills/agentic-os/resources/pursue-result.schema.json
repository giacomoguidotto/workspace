{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-os.pursue.result/v1",
  "title": "Agentic OS Pursue Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability",
    "status",
    "readiness",
    "personalization",
    "selected",
    "suppressed",
    "research_blocked",
    "plans",
    "draft_packs",
    "wait_recommendations",
    "safe_advances",
    "evidence_sufficiency",
    "capacity_shortfall",
    "reconciliation",
    "required_approvals",
    "proposed_captures",
    "blocked_actions"
  ],
  "properties": {
    "schema": { "const": "agentic-os.pursue.result/v1" },
    "capability": { "const": "agentic-os.pursue" },
    "status": { "enum": ["completed", "blocked", "incomplete", "failed"] },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "career"],
      "properties": {
        "knowledge": { "$ref": "#/$defs/readiness" },
        "career": { "$ref": "#/$defs/readiness" }
      }
    },
    "personalization": {
      "enum": ["personalized", "generic-defaults"]
    },
    "selected": { "$ref": "#/$defs/references" },
    "suppressed": { "$ref": "#/$defs/summaries" },
    "research_blocked": { "$ref": "#/$defs/summaries" },
    "plans": { "$ref": "#/$defs/references" },
    "draft_packs": { "$ref": "#/$defs/references" },
    "wait_recommendations": { "$ref": "#/$defs/summaries" },
    "safe_advances": { "$ref": "#/$defs/summaries" },
    "evidence_sufficiency": { "$ref": "#/$defs/summary" },
    "capacity_shortfall": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "reconciliation": { "$ref": "#/$defs/summary" },
    "required_approvals": { "$ref": "#/$defs/summaries" },
    "proposed_captures": { "$ref": "#/$defs/summaries" },
    "blocked_actions": { "$ref": "#/$defs/summaries" }
  },
  "$defs": {
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed_at", "capabilities", "reasons"],
      "properties": {
        "status": { "enum": ["ready", "blocked", "failed"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/summary" }
    },
    "references": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
