{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-system-interface/v1/project-snapshot-request.schema.json",
  "title": "Knowledge Project Snapshot Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface", "snapshot", "caller", "capability", "objective", "project_references"],
  "properties": {
    "interface": { "const": "knowledge-system-interface/v1" },
    "snapshot": { "const": "knowledge.project.snapshot/v1" },
    "caller": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "project_references": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
