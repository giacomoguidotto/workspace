{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-system-interface/v1/snapshot-token-validation-result.schema.json",
  "title": "Snapshot Token Validation Result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "status", "caller", "capability"],
      "properties": {
        "interface": { "const": "knowledge-system-interface/v1" },
        "status": { "enum": ["unchanged", "changed"] },
        "caller": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "status", "reason"],
      "properties": {
        "interface": { "const": "knowledge-system-interface/v1" },
        "status": { "const": "malformed" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "status", "requested_interface"],
      "properties": {
        "interface": { "const": "knowledge-system-interface/v1" },
        "status": { "const": "unsupported" },
        "requested_interface": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "status", "caller", "capability", "reason"],
      "properties": {
        "interface": { "const": "knowledge-system-interface/v1" },
        "status": { "const": "unresolved" },
        "caller": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "reason": {
          "enum": [
            "owner_unknown",
            "evidence_insufficient",
            "stale",
            "access_blocked",
            "revision_uncertain",
            "persistent_drift"
          ]
        }
      }
    }
  ]
}
