{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-system-interface/v1/project-snapshot-operation.schema.json",
  "title": "Knowledge Project Snapshot Operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "registry_revision", "observations"],
  "properties": {
    "request": { "$ref": "project-snapshot-request.schema.json" },
    "registry_revision": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "observed_at", "revision_token", "projects"],
            "properties": {
              "state": { "const": "resolved" },
              "observed_at": { "type": "string", "format": "date-time" },
              "revision_token": { "type": "string", "minLength": 16 },
              "projects": {
                "type": "array",
                "items": { "$ref": "project-snapshot.schema.json#/$defs/project_result" },
                "minItems": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "observed_at", "revision_token", "reason"],
            "properties": {
              "state": { "const": "unresolved" },
              "observed_at": { "type": "string", "format": "date-time" },
              "revision_token": { "type": "string", "minLength": 16 },
              "reason": {
                "enum": ["owner_unknown", "evidence_insufficient", "stale", "access_blocked", "revision_uncertain"]
              }
            }
          }
        ]
      }
    }
  }
}
