{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-system-interface/v1/snapshot.schema.json",
  "title": "Knowledge Context Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface", "registry_revision", "caller", "capability", "capability_status", "results", "gaps", "snapshot_token"],
  "properties": {
    "interface": { "const": "knowledge-system-interface/v1" },
    "registry_revision": { "type": "string", "minLength": 1 },
    "caller": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "capability_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "depends_on_roles", "blocking_roles"],
      "properties": {
        "state": { "enum": ["ready", "blocked"] },
        "depends_on_roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "blocking_roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
          "then": { "properties": { "blocking_roles": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "state": { "const": "blocked" } }, "required": ["state"] },
          "then": { "properties": { "blocking_roles": { "minItems": 1 } } }
        }
      ]
    },
    "results": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/result" }
    },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
    "snapshot_token": { "type": "string", "minLength": 16 }
  },
  "$defs": {
    "visibility": { "enum": ["private", "public-facing", "restricted", "mixed"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "supports"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "supports": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "label", "role", "observed_revision", "retrieved_at", "support"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "role": { "enum": ["canonical-owner", "supporting-evidence"] },
        "link": { "type": "string", "format": "uri" },
        "observed_revision": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "support": { "enum": ["supported", "partial", "conflicting"] }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "visibility", "restrictions", "evidence", "provenance"],
      "properties": {
        "claim": {},
        "visibility": { "$ref": "#/$defs/visibility" },
        "restrictions": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1 },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" }, "minItems": 1 }
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "visibility", "claims"],
          "properties": {
            "state": { "const": "value" },
            "visibility": { "$ref": "#/$defs/visibility" },
            "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "minItems": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "visibility", "restrictions", "evidence", "provenance"],
          "properties": {
            "state": { "const": "absent" },
            "visibility": { "$ref": "#/$defs/visibility" },
            "restrictions": { "type": "array", "items": { "type": "string" } },
            "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1 },
            "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" }, "minItems": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "visibility", "reason", "attempted_provenance"],
          "properties": {
            "state": { "const": "unresolved" },
            "visibility": { "$ref": "#/$defs/visibility" },
            "reason": { "enum": ["owner_unknown", "evidence_insufficient", "stale", "access_blocked", "revision_uncertain", "persistent_drift"] },
            "attempted_provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
          }
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "reason", "blocks_capability"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "blocks_capability": { "type": "boolean" }
      }
    }
  }
}
